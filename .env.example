# Fixture-only defaults. No provider or account credentials are accepted.
DATA_MODE=fixture-only
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Dashboard Node installation directory, relative to this project or absolute.
# Empty: automatically use the portable Windows runtime when installed, else system Node.
NODE_RUNTIME_DIR=
# Explicit persistence CLI configuration; fixture dev/doctor still need no database.
DATABASE_URL=postgresql://research@127.0.0.1:5432/crypto_research
DATABASE_SCHEMA=crypto_fixture_local
# Integration tests use TEST_DATABASE_URL from the environment (see docs/persistence.md).
# Forward paper trading uses public exchange GET requests and an independent PostgreSQL schema.
LIVE_PAPER_ENABLED=0
LIVE_PAPER_AUTO_DB=0
LIVE_PAPER_DATABASE_URL=postgresql://research@127.0.0.1:55439/postgres
# On Windows, AUTO_DB=1 starts only .tools/postgres-live-paper (not a Windows service).
# PG_BIN_DIR=C:/Program Files/PostgreSQL/18/bin
# VPS hosting: OPS_MODE=hosted-paper, HTTPS origins, three distinct random secrets.
# The proxy secret must be injected by an authenticated loopback nginx location,
# never sent to browser JavaScript. Keep generated values in /etc/crypto-trader/app.env.
# OPS_MODE=hosted-paper
# OPS_ALLOWED_ORIGINS=https://crypto-trader.example.org
# OPS_READ_TOKEN=
# OPS_ADMIN_TOKEN=
# OPS_PROXY_SECRET=
# Compose workers read their own private persistent env files; see docs/compose-deployment.md.
# LIVE_PAPER_SCHEDULER=bullmq
# REDIS_URL=redis://default:generated-password@redis:6379/0
# WORKER_RPC_URL=http://worker:3102
# WORKER_RPC_TOKEN=
# Production backups are disabled by operator request; do not enable during deployments.
BACKUPS_ENABLED=0
# Telegram notifier: private server-side settings only. Never expose in NEXT_PUBLIC variables.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_DATABASE_URL=
TELEGRAM_DASHBOARD_URL=http://127.0.0.1:3100/live-paper

# Independent exploratory news forward paper trading; private server .env stores credentials.
NEWS_FORWARD_ENABLED=0
NEWS_FORWARD_DATABASE_URL=
NEWS_FORWARD_REPORT_ID=
NEWS_FORWARD_REPORT_HASH=
# News collection and analysis run as independent Compose services.
# Never put a provider key in a source URL or browser settings.
# NEWS_DATABASE_URL=postgresql://crypto_news_app:generated-password@postgres:5432/crypto_news
NEWS_AI_BASE_URL=https://api.deepseek.com
NEWS_AI_MODEL=deepseek-flash
NEWS_AI_API_KEY=
NEWS_AI_DAILY_LIMIT=100
