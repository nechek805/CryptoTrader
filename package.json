{
  "name": "crypto-intelligence-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "queue:worker": "node --env-file-if-exists=.env --import tsx apps/api/src/queue-main.ts",
    "queue:maintenance": "node --env-file-if-exists=.env --import tsx apps/api/src/maintenance-main.ts",
    "live-paper": "node --env-file-if-exists=.env --import tsx apps/cli/src/live-paper.ts",
    "short-v6": "node --env-file-if-exists=.env --import tsx apps/cli/src/short-v6.ts",
    "directional-tests": "node --env-file-if-exists=.env --import tsx apps/cli/src/directional-tests.ts",
    "specialist-v5": "node --env-file-if-exists=.env --import tsx apps/cli/src/specialist-v5.ts",
    "specialist-tests": "node --env-file-if-exists=.env --import tsx apps/cli/src/specialist-tests.ts",
    "market-tests": "node --env-file-if-exists=.env --import tsx apps/cli/src/market-strategy-tests.ts",
    "btc-test": "node --env-file-if-exists=.env --import tsx apps/cli/src/btc-test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx apps/cli/src/main.ts doctor",
    "smoke": "node --env-file-if-exists=.env --import tsx apps/cli/src/main.ts smoke --dry-run",
    "demo:contracts": "node --import tsx apps/cli/src/contracts-demo.ts",
    "market": "node --env-file-if-exists=.env --import tsx apps/cli/src/market.ts",
    "news": "node --env-file-if-exists=.env --import tsx apps/cli/src/news.ts",
    "study": "node --env-file-if-exists=.env --import tsx apps/cli/src/event-study.ts",
    "features": "node --env-file-if-exists=.env --import tsx apps/cli/src/features.ts",
    "replay": "node --env-file-if-exists=.env --import tsx apps/cli/src/replay.ts",
    "backtest": "node --env-file-if-exists=.env --import tsx apps/cli/src/backtest.ts",
    "ml": "node --env-file-if-exists=.env --import tsx apps/cli/src/market-ml.ts",
    "robustness": "node --env-file-if-exists=.env --import tsx apps/cli/src/robustness.ts",
    "news-signal": "node --env-file-if-exists=.env --import tsx apps/cli/src/news-signal.ts",
    "news-edge": "node --env-file-if-exists=.env --import tsx apps/cli/src/news-edge.ts",
    "news-audit": "node --env-file-if-exists=.env --import tsx apps/cli/src/news-audit.ts",
    "fusion": "node --env-file-if-exists=.env --import tsx apps/cli/src/fusion.ts",
    "paper": "node --env-file-if-exists=.env --import tsx apps/cli/src/paper.ts",
    "evaluation": "node --env-file-if-exists=.env --import tsx apps/cli/src/evaluation.ts",
    "experiment": "node --env-file-if-exists=.env --import tsx apps/cli/src/experiment.ts",
    "prototype:entities": "node --import tsx research_prototypes/source-entities/run.ts",
    "dashboard": "node apps/cli/start-dashboard.mjs",
    "dashboard:api": "node --env-file-if-exists=.env --import tsx apps/api/src/operations-main.ts",
    "web:build": "pnpm --filter @crypto/web build",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/cli/src/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx apps/cli/src/database.ts seed",
    "db:clean": "node --env-file-if-exists=.env --import tsx apps/cli/src/database.ts clean",
    "lint": "pnpm --filter @crypto/web typegen && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && pnpm --filter @crypto/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:db": "pnpm check && pnpm test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke && pnpm demo:contracts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@crypto/api": "workspace:*",
    "@crypto/backtest": "workspace:*",
    "@crypto/connectors": "workspace:*",
    "@crypto/contracts": "workspace:*",
    "@crypto/core": "workspace:*",
    "@crypto/db": "workspace:*",
    "@crypto/evaluation": "workspace:*",
    "@crypto/news": "workspace:*",
    "@crypto/paper": "workspace:*",
    "@crypto/research": "workspace:*",
    "@crypto/risk": "workspace:*",
    "@crypto/strategies": "workspace:*",
    "@crypto/worker": "workspace:*",
    "@duckdb/node-api": "1.4.4-r.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
